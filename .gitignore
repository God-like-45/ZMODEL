# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Environments
.venv/
env/
venv/
ENV/

# Secrets and environment variables
.env
.env.local
*.env

# SQLite local test databases
*.db
*.sqlite
*.sqlite3

# Pytest & test caches
.pytest_cache/
.coverage
htmlcov/

# Temporary files, cdp profiles & logs
temp_cdp*/
temp_profile*/
temp_test_profile/
*.log

# Model artifacts and uploads (avoid committing runtime binaries)
scratch/
uploads/
artifacts/
