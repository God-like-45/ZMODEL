# ==============================================================================
# Z-ModelPilot — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure with your local environment settings.
# Do NOT commit .env or any file containing actual production credentials.

# ------------------------------------------------------------------------------
# Primary PostgreSQL Connection URL
# ------------------------------------------------------------------------------
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://zmodel_user:zmodel_password@localhost:5432/zmodel_db

# Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800

# SQLite Fallback / Offline Testing (Optional)
# If set to true, allows automatic SQLite file fallback if PostgreSQL is unreachable
# DB_ALLOW_SQLITE_FALLBACK=true
# SQLITE_DATABASE_PATH=zmodel_local.db

# ------------------------------------------------------------------------------
# FastAPI REST API Configuration (Phase 7)
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & Upload Limits
MAX_UPLOAD_SIZE_MB=50
MAX_UPLOAD_SIZE_BYTES=52428800
MAX_BENCHMARK_ITERATIONS=1000
MAX_BENCHMARK_WARMUP=100
MAX_CANDIDATE_COUNT=50

# Concurrency & In-Process Job Manager
JOB_CONCURRENCY=2
MAX_QUEUED_JOBS=20

# CORS Allowed Origins (Comma-separated, e.g. http://localhost:8501,http://localhost:3000 or *)
CORS_ALLOWED_ORIGINS=*

# Streamlit UI Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
